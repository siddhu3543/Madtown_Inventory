{
  "name": "madtown-inventory",
  "version": "0.1.0",
  "private": true,
  "description": "Madtown Inventory Management Application (Phase 1 MVP + Phase 2; Phase 3 roadmap)",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:local": "bash scripts/local-postgres.sh",
    "db:migrate": "tsx --conditions=react-server scripts/migrate.ts",
    "db:reset": "tsx --conditions=react-server scripts/migrate.ts --reset",
    "db:seed": "tsx --conditions=react-server scripts/seed.ts",
    "import:sheet": "tsx --conditions=react-server scripts/import-sheet.ts",
    "job": "tsx --conditions=react-server scripts/run-job.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:int": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "rtm": "tsx --conditions=react-server scripts/generate-rtm.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "bcryptjs": "^3.0.3",
    "google-auth-library": "^10.9.1",
    "idb": "^8.0.4",
    "jose": "^6.2.17",
    "next": "^15.5.29",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.1.10",
    "react-dom": "^19.1.10",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "3.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
