# ---- Madtown Inventory environment variables (NFR-005: secrets only here, never in the repo) ----
APP_ENV=staging                     # local | local-staging | test | staging | production
APP_BASE_URL=https://staging.inventory.madtown.in
QR_BASE_URL=https://inventory.madtown.in   # FR-QR-001: printed labels encode QR_BASE_URL/i/<ID>; keep stable (A3)

# Database (Supabase). Pooler connection string for a role that may SET ROLE authenticated/service_role (not service key).
DATABASE_URL=postgres://postgres.<project>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
MIGRATION_DATABASE_URL=            # direct connection, migrations only (prefer `supabase db push`)

# Auth (ADR-08). staging/production: supabase (Google, hd=madtown.in). local only: local
AUTH_PROVIDER=supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only: user invites
SESSION_SECRET=                     # 32+ random bytes (local provider sessions)
ALLOW_LOCAL_AUTH=                   # leave empty in staging/production

CRON_SECRET=                        # Vercel Cron sends Authorization: Bearer <CRON_SECRET>

# Photos (FR-PHO-004, A4): drive | local
STORAGE_PROVIDER=drive
GOOGLE_SERVICE_ACCOUNT_JSON_B64=    # base64 of the Workspace service-account JSON key (least privilege; shared drive member)
GOOGLE_DRIVE_ROOT_FOLDER_ID=        # shared-drive folder "Madtown Inventory" (one subfolder per item is created)
LOCAL_STORAGE_DIR=.storage

# Email (Resend; A2): resend | outbox
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=Madtown Inventory <inventory@madtown.in>
EMAIL_SANDBOX_TO=staging-inbox@madtown.in   # STAGING: every message redirected here (A3). Ignored when APP_ENV=production.

# Sheets mirror (FR-RPT-009): sheets | csv
MIRROR_PROVIDER=sheets
MIRROR_SPREADSHEET_ID=
MIRROR_CSV_DIR=.mirror

# Phase 2 Slack (disabled until the channel exists)
SLACK_WEBHOOK_URL=
