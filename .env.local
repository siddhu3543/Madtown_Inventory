APP_ENV=local
APP_BASE_URL=http://localhost:3000

DATABASE_URL=postgres://app_server:app_server_local_only@127.0.0.1:54322/madtown_staging

MIGRATION_DATABASE_URL=postgres://postgres@127.0.0.1:54322/madtown_staging

AUTH_PROVIDER=local
ALLOW_LOCAL_AUTH=1

SESSION_SECRET=replace_with_a_random_secret_at_least_32_characters
CRON_SECRET=replace_with_another_random_secret

STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=.storage

EMAIL_PROVIDER=outbox
EMAIL_SANDBOX_TO=staging-inbox@madtown.in

MIRROR_PROVIDER=csv
MIRROR_CSV_DIR=.mirror